# მიგრაციისთვის სასურველია direct DATABASE_URL: სესიური advisory lock transaction pooler-ზე გარანტიას არ იძლევა.
DATABASE_URL=postgresql://ertad@127.0.0.1:55432/ertad
APP_URL=http://localhost:3000
# Generate with npm run admin:setup. Never commit actual values.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Invoice emails only. Enable after verifying jobx.ge and its receiving mailbox.
RESEND_API_KEY=
INVOICE_EMAIL_ENABLED=false
CRON_SECRET=
CRAWL_BATCH_SIZE=20
CRAWL_DELAY_MS=2000

# Optional server-only fine-grained token: this repository, Actions read/write.
GITHUB_ACTIONS_TOKEN=

# Server-only Google service account; API must be enabled and the account must own jobx.ge in Search Console.
# GitHub Actions secrets are sufficient: publishers without these values still persist notifications.
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=
GOOGLE_INDEXING_DAILY_LIMIT=200
