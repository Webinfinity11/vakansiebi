    "source:probe": "tsx scripts/probe.ts",
    "worker:gov": "zsh scripts/local-gov-sources.sh --loop",
    "admin:setup": "node scripts/admin-setup.mjs",
    "local:start": "node scripts/local-start.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
